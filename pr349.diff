+name: Security Vulnerability
+description: Report a security vulnerability (private disclosure)
+title: "[Security]: "
+labels: ["security", "triage"]
+body:
+  - type: markdown
+    attributes:
+      value: |
+        **Thank you for responsibly disclosing a security vulnerability.**
+        
+        This issue will be treated with urgency. Please provide as much detail as possible.
+        For critical vulnerabilities (financial loss, key extraction), consider using
+        [GitHub's private vulnerability reporting](https://github.com/Conway-Research/automaton/security/advisories/new)
+        instead of a public issue.
+
+  - type: dropdown
+    id: severity
+    attributes:
+      label: Severity
+      description: How severe is this vulnerability?
+      options:
+        - Critical — financial loss, RCE, private key extraction
+        - High — auth bypass, injection, data leak
+        - Medium — DoS, logic errors
+        - Low — informational
+    validations:
+      required: true
+
+  - type: dropdown
+    id: cwe
+    attributes:
+      label: CWE Category
+      description: Common Weakness Enumeration category (if known)
+      options:
+        - CWE-78: OS Command Injection
+        - CWE-89: SQL Injection
+        - CWE-918: Server-Side Request Forgery
+        - CWE-367: TOCTOU Race Condition
+        - CWE-200: Information Exposure
+        - CWE-287: Improper Authentication
+        - CWE-862: Missing Authorization
+        - Other / Not sure
+
+  - type: textarea
+    id: description
+    attributes:
+      label: Vulnerability Description
+      description: What is the vulnerability? What can an attacker do?
+    validations:
+      required: true
+
+  - type: textarea
+    id: reproduction
+    attributes:
+      label: Steps to Reproduce
+      description: How can this be reproduced?
+    validations:
+      required: true
+
+  - type: textarea
+    id: impact
+    attributes:
+      label: Impact Assessment
+      description: What is the worst-case impact? Can this lead to financial loss?
+    validations:
+      required: true
+
+  - type: textarea
+    id: fix
+    attributes:
+      label: Suggested Fix
+      description: Do you have a suggestion for how to fix this?
+
+  - type: checkboxes
+    id: checklist
+    attributes:
+      label: Disclosure
+      options:
+        - label: I have not publicly disclosed this vulnerability
+          required: true
+        - label: I agree to coordinated disclosure (fix first, then publish)
+          required: true
